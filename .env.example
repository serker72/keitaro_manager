# --- Environment ---
PROJECT_ENVIRONMENT=loc
PROJECT_NAME=keitaro_manager
APP_UID=1000
APP_GID=1000

# --- Data directories (bind mounts) ---
PROJECT_DATA_DIR=/opt/keitaro_manager_data
POSTGRES_DATA_DIR="${PROJECT_DATA_DIR}/db"
LOGS_DATA_DIR="${PROJECT_DATA_DIR}/logs"

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=keitaro_manager
POSTGRES_PASSWORD=change_me
POSTGRES_DB=keitaro_manager

# --- Keitaro ---
KEITARO_BASE_URL=https://tlgk.host/admin
KEITARO_API_KEY=
# Публичный адрес трекера для ссылок в UI (превью офферов, VIEW IN KT).
# Пусто = выводится из KEITARO_BASE_URL без суффикса /admin
KEITARO_PUBLIC_URL=

# --- Host ports (published on 127.0.0.1, with +20000 shift for test env) ---
POSTGRES_PORT_HOST=5432
BACKEND_PORT_HOST=33000
FRONTEND_PORT_HOST=3000
